# Environment Configuration
# Copy this file to .env and update with your values

# App Configuration
NODE_ENV=development
PORT=5000
APP_NAME=LocalMind
APP_VERSION=1.0.0

# Firebase Configuration
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_SERVICE_ACCOUNT_KEY=path/to/serviceAccountKey.json

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=24h
REFRESH_TOKEN_EXPIRE=7d

# Twilio Configuration (SMS/OTP)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# SendGrid Configuration (Email)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@localmind.app
SENDGRID_FROM_NAME=LocalMind

# OpenAI Configuration (AI Features)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key

# Razorpay Configuration (Payments)
RAZORPAY_KEY_ID=your_razorpay_key
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Google Maps API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Cloudinary Configuration (Image Storage)
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Database
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/localmind?retryWrites=true&w=majority
POSTGRES_URL=postgresql://user:password@localhost:5432/localmind_analytics

# Application URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
WEBSOCKET_URL=http://localhost:5000

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://localmind.app

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Email Configuration
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key

# AWS S3 (Optional)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=localmind-uploads
AWS_REGION=ap-south-1

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Security
BCRYPT_ROUNDS=10
SESSION_SECRET=your_session_secret_change_this

# Feature Flags
FEATURE_AI_RECOMMENDATIONS=true
FEATURE_MARKETPLACE=true
FEATURE_SERVICES=true
FEATURE_BUSINESS_DASHBOARD=true
FEATURE_ADMIN_PANEL=true

# Analytics
MIX_PANEL_TOKEN=your_mixpanel_token
SENTRY_DSN=your_sentry_dsn

# Moderation
AI_MODERATION_ENABLED=true
AI_MODERATION_THRESHOLD=0.7

# Notification
FCM_SERVER_KEY=your_fcm_server_key
FCM_SENDER_ID=your_fcm_sender_id
